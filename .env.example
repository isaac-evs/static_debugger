DISABLE_LOGGING=true
LOG_LEVEL=INFO

# Used by model/misc/generate_test_cases.py (and cli.py --generate-ai-tests)
# for AI test case generation. Only the provider(s) you actually use need a
# key -- the frontend also lets you paste one in per-request instead.
# Claude:  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ChatGPT: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Gemini:  https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=
